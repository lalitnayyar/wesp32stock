# Lalit Stock Application - Caddy reverse proxy. Owner: Lalit Nayyar. Not financial advice.
# SITE_ADDRESS examples: "localhost" (local HTTPS with Caddy's internal CA),
# "stock.example.com" (automatic Let's Encrypt on a VPS), ":80" (plain HTTP behind another proxy).
# LAN_ADDRESS: this machine's LAN IP (e.g. 192.168.1.50) so other devices can open https://<ip>/.
{
	email {$ACME_EMAIL:admin@example.com}
	# Listen on the same ports the host publishes (HTTP_PORT/HTTPS_PORT in .env), so the
	# HTTP->HTTPS redirect and generated URLs carry the right port (e.g. https://localhost:5175).
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	# Browsers send no SNI when browsing by IP; without this Caddy cannot pick a certificate.
	default_sni {$LAN_ADDRESS:127.0.0.1}
}

(app) {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}
	# ESP32 firmware for the "Flash ESP32" page, built by ./manage.sh firmware into firmware/dist.
	handle_path /firmware/* {
		root * /firmware
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}

{$SITE_ADDRESS:localhost} {
	import app
}

# Access by IP address. Explicit `tls internal` makes Caddy accept SNI-less handshakes for it;
# kept separate so SITE_ADDRESS still gets automatic Let's Encrypt on a VPS.
{$LAN_ADDRESS:127.0.0.1} {
	tls internal
	import app
}
