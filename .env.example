# Lalit Stock Application - environment template. Copy to .env (./manage.sh env does this for you).
# Never commit .env. Owner: Lalit Nayyar. Not financial advice.
# Keep comments on their own lines (Docker Compose may treat inline text as part of a value).

# development | production (production disables the simulator by default)
APP_ENV=development
# >= 32 random characters - generate with: ./manage.sh secrets
APP_SECRET_KEY=
POSTGRES_DB=lalitstock
POSTGRES_USER=lalitstock
# random - generate with: ./manage.sh secrets
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
# >= 12 characters; used only to create the first admin account
ADMIN_PASSWORD=
# yahoo | fixture (offline demo data)
MARKET_PROVIDER=yahoo
# blank = enabled outside production; true/false to force
SIMULATOR_ENABLED=
# keep true behind HTTPS
COOKIE_SECURE=true
# VPS: your domain, e.g. stock.example.com ; local: localhost
SITE_ADDRESS=localhost
ACME_EMAIL=consult@lalit.cloud
HTTP_PORT=80
HTTPS_PORT=443
# 0.0.0.0 lets an ESP32 on your LAN use http://<pc-ip>:DEVICE_LAN_PORT (development only)
DEVICE_LAN_BIND=127.0.0.1
DEVICE_LAN_PORT=8000
LOG_LEVEL=INFO
